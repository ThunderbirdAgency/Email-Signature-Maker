# Absolute, publicly reachable base URL. Images inside a signature are hot-linked
# from this origin by the recipient's mail client, so it must be public.
NEXT_PUBLIC_APP_URL=https://getsmartstamp.com

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Postgres connection string. Set this and everything is stored in Postgres.
# On Supabase use the transaction pooler URI (port 6543) — it is built for
# serverless. Leave unset to fall back to the filesystem.
DATABASE_URL=

# Where the filesystem fallback keeps its data (default: ./.data)
DATA_DIR=

# --- Payments (entirely optional) ------------------------------------------
# Pricing is $10 per signature; buying 5 in a rolling 12 months adds 10 free.
#
# The paywall only engages when BILLING_ENABLED is "true" AND both Stripe keys
# below are present. Turning the flag on without them would block every export
# with no way to pay, so it stays off until Stripe is actually wired.
BILLING_ENABLED=false

# Stripe secret key: Developers -> API keys.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint you point at
# https://your-domain/api/webhooks/stripe, listening for
# checkout.session.completed. Credits are granted there and nowhere else.
STRIPE_WEBHOOK_SECRET=
