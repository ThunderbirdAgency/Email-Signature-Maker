# Absolute, publicly reachable base URL. Images inside a signature are hot-linked
# from this origin by the recipient's mail client, so it must be public.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Where accounts, signatures and uploads are persisted (default: ./.data)
DATA_DIR=

# --- Paywall (entirely optional) -------------------------------------------
# Leave BILLING_ENABLED unset or "false" and every Pro feature is free for
# everyone. Set to "true" to gate Pro features behind an upgrade.
BILLING_ENABLED=false
